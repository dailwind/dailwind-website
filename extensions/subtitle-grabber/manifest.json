{
  "manifest_version": 3,
  "name": "Dailwind Subtitle Grabber",
  "version": "1.0.0",
  "description": "Collects YouTube subtitles for the Dailwind Subtitle Corpus Builder. Runs in your own browser; nothing is sent to Dailwind.",
  "homepage_url": "https://dailwind.com/subtitle-corpus/",
  "permissions": [],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://dailwind.com/subtitle-corpus/*",
        "https://www.dailwind.com/subtitle-corpus/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
